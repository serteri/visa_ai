# Environment Variables Template

## Database (Neon PostgreSQL)
# Copy .env to .env.local and add your actual connection string:
# DATABASE_URL: the single (production) database, locally and on Vercel.
# DATABASE_URL="postgresql://user:password@host/database?sslmode=require&channel_binding=require"
# PROD_DATABASE_URL: the same production database, used by scripts that must read production, always in a
# READ ONLY transaction (scripts/lib/prod-db.ts). Prefer a read-only Neon role. See docs/database-environments.md.
# PROD_DATABASE_URL="postgresql://readonly_user:password@prod-host/database?sslmode=require"

## Email notifications (Resend)
# RESEND_API_KEY="re_xxxxxxxxx"
# REFERRAL_NOTIFICATION_EMAIL="owner@example.com"
# FROM_EMAIL="Visa AI <onboarding@resend.dev>"

## Optional RAG answer generation model settings
# OPENAI_API_KEY="sk-..."
# OPENAI_MODEL="gpt-4o-mini"

## Analytics (GA4)
# NEXT_PUBLIC_GA_ID="G-XXXXXXXXXX"
# Search Console verification: the content value of the google-site-verification meta tag (unset or empty: no tag is rendered; there is no built-in token).
# SEARCH_CONSOLE_VERIFICATION=""

## Full-check admin controls
# ADMIN_EMAILS="founder@logivisa.com,test@test.com"
# ADMIN_SECRET="your-super-secret-password"

## Stripe (AI assistant one-time credit packages, see app/[locale]/pricing)
# STRIPE_SECRET_KEY="sk_live_..."
# NEXT_PUBLIC_BASE_URL="https://www.logivisa.com"
# Create these as one-time Prices in Stripe Dashboard -> Products
# NEXT_PUBLIC_STRIPE_STARTER_CREDITS_PRICE_ID="price_..."
# NEXT_PUBLIC_STRIPE_COMPREHENSIVE_CREDITS_PRICE_ID="price_..."
# Returning-customer discount on premium report checkout (app/api/checkout/
# route.ts) -- create a percent_off Coupon once in Stripe Dashboard -> Coupons
# and put its ID here. Falls back to "LOYALTY30" if unset.
# STRIPE_LOYALTY_COUPON_ID="LOYALTY30"

## Never commit .env.local to version control!
# .env.local is automatically gitignored.

# Paid Visa Information Report checkout (Stripe product "premium"). ON by default; set exactly "false" to switch the sale off
# (reports already unlocked stay unlocked).
# READINESS_REPORT_PAID_CHECKOUT_ENABLED="false"

# Report generation switches (server-side). READINESS_REPORT_MODE: REVIEW (default) | INFORMATION | DISABLED.
# Canada report generation stays off during the beta unless CANADA_REPORT_ENABLED is exactly "true".
# READINESS_REPORT_MODE=REVIEW
# CANADA_REPORT_ENABLED=

# Optional: ONE Stripe coupon id whose orders are treated as owner orders (no customer email, no PAID notification). Unset = no coupon ever suppresses.
# Report emails are otherwise suppressed only for recipient addresses in ADMIN_EMAILS / KNOWN_TEST_EMAILS.
ADMIN_FREE_COUPON_ID=

# Operator notification address(es) for ALL internal notifications (PAID, free-unlock, quick-check lead tier, guide leads, contact, alerts); comma separated.
# Unset: each sender keeps its previous variable / default. Never used to decide whether to send.
ADMIN_NOTIFICATION_EMAIL="serter@logivisa.com,hello@logivisa.com"
