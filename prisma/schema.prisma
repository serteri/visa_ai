// ─────────────────────────────────────────────────────────────────────────
// ⚠️  TWO ORMS, ONE DATABASE — READ BEFORE RUNNING ANY `prisma db push` OR
// `prisma migrate` COMMAND.
//
// This database is shared between Prisma (this file) and Drizzle
// (db/schema.ts). The tables below are Drizzle-owned — Prisma only knows
// about them because they were introspected via `prisma db pull` and
// marked `@@ignore` so Prisma Client won't expose them and `db push` won't
// try to drop/alter them:
//   - campaigns
//   - contact_messages
//   - pdf_downloads
//   - visa_types
//   - visa_structured_data
//   - source_snapshots
//
// NEVER run `prisma db push --accept-data-loss` without reading the diff
// first. If it proposes dropping any table, STOP — it means either a new
// Drizzle table needs the same @@ignore treatment (re-run `prisma db pull`
// to pick it up, then re-add `@@ignore`), or something is genuinely wrong.
// Prefer a targeted `ALTER TABLE` for schema changes to this file's own
// models over a full `db push` when in doubt.
//
// Drizzle also declares a few tables that don't exist in the live database
// yet (full_check_usage, full_check_waitlist, leads) — those are handled
// gracefully as optional/missing by application code and are not Prisma's
// concern. visa_types/visa_structured_data/source_snapshots USED to be in
// this "doesn't exist yet" bucket too, until they were created + seeded
// (db/seed.ts) and promptly proposed for a DROP by an uninformed `db push`
// — see the @@ignore models above for the fix.
// ─────────────────────────────────────────────────────────────────────────

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

model UserReport {
  id                    String        @id @default(uuid())
  fullName              String?       @map("full_name")
  email                 String
  phone                 String?
  preferredPath         String?       @map("preferred_path")
  source                String        @default("full_check")
  locale                String        @default("en")
  leadScore             Int?          @map("lead_score")
  leadTier              String?       @map("lead_tier")
  paymentStatus         String        @default("pending") @map("payment_status")
  unlockMethod          String?       @map("unlock_method")
  isUnlocked            Boolean       @default(false) @map("is_unlocked")
  pdfSent               Boolean       @default(false) @map("pdf_sent")
  reportJson            Json          @map("report_json")
  inputJson             Json          @map("input_json")
  // CRM: the AGENT (User) this lead is routed to. Nullable — unassigned leads
  // sit in the pool until an admin/agent claims them.
  agentId               String?       @map("agent_id")
  agent                 User?         @relation("AgentAssignedLeads", fields: [agentId], references: [id], onDelete: SetNull)
  createdAt             DateTime      @default(now()) @map("created_at")
  unlockedAt            DateTime?     @map("unlocked_at")
  ipAddress             String?       @map("ip_address")
  // Points-based internal lead tier (Hot/Warm/Cold, from estimatedPoints +
  // occupationEligibility) — distinct from leadScore/leadTier above, which
  // is a separate, unrelated form-completeness/intent scorer. Cold is never
  // persisted as a truthy email-sent flag since no email is sent for Cold.
  pointsTier            String?       @map("points_tier")
  internalLeadEmailSent Boolean?      @default(false) @map("internal_lead_email_sent")
  // Agent CRM workflow: document/skills-assessment review status, editable
  // only by the agent this lead is assigned to (see requireOwnedLead in
  // lib/crm/leads.ts). market scopes which agents can see/claim the lead
  // from the shared pool -- "TR" for Turkish Guide leads (Turkey-market
  // agents only), null/"GLOBAL" for Global Guide + Occupation List leads
  // (any agent).
  docStatus             String?       @default("New") @map("doc_status")
  // Legacy free-text note log (JSON array of {text, at}), written only by
  // the owning agent -- superseded by the LeadNote model below (shared,
  // authored, readable/writable by both the owning agent and any admin).
  // Kept read-only for notes written before that migration; no longer
  // written to.
  agentNotes            String?       @map("agent_notes")
  market                String?       @default("GLOBAL")
  // Affiliate/referral auto-assignment: true when this lead was routed
  // directly to `agentId` at creation time because the visitor arrived via
  // that agent's ?ref=<agentId> link (see the ref cookie flow in
  // full-check/actions.ts), instead of landing in the manual pool.
  assignedViaRef        Boolean?      @default(false) @map("assigned_via_ref")
  // Free-launch-promo grant: true when this report's premium unlock was
  // given away as one of the first N free spots (see app/api/checkout/
  // route.ts) rather than paid for. Counted against the promo cap via an
  // atomic UPDATE ... WHERE (SELECT COUNT...) < N, so this column also
  // doubles as the concurrency guard -- never set it directly outside that
  // query.
  isFreePromo           Boolean       @default(false) @map("is_free_promo")
  // Quick Pathway Check snapshot (estimated points + up to 3 candidate
  // pathways) generated the moment the free form completes -- persisted so
  // a returning visitor to result?reportId=... sees the same preview
  // instead of a blank/redirected page while their report is still locked.
  // Distinct from reportJson (the full premium report, populated at
  // generation time regardless of unlock state) -- this is only the
  // pre-payment teaser subset.
  previewData           Json?         @map("preview_data")
  transactions          Transaction[]
  notes                 LeadNote[]

  // agentId: FK filter for getAgentLeads/getUnassignedLeads (agentId: null),
  // composite with pointsTier because getAllAgentMetrics groupBy's on both.
  // createdAt: ORDER BY in admin/agent dashboard lead lists.
  @@index([agentId, pointsTier])
  @@index([createdAt])
  @@map("user_reports")
}

// Affiliate commission ledger. LogiVisa's own Stripe account collects 100%
// of every payment -- agents are never paid out through Stripe. This is a
// read-only record of what an agent *earned* (commissionAmount) on a given
// sale, computed once at webhook time and stored, not recomputed later --
// see recordCommissionTransaction() in lib/stripe/commission.ts for why
// commissionRate/commissionAmount are persisted rather than derived from a
// rate that could change in the future.
model Transaction {
  id               String   @id @default(uuid())
  // Optional -- not every sale has a CRM lead behind it (e.g. a direct
  // lead-magnet campaign PDF purchase with no assessment report). Creating a
  // placeholder UserReport just to satisfy a required FK would pollute CRM
  // conversion metrics with fake leads, so this ledger table stands on its
  // own for those sales instead (see buyerEmail below).
  leadId           String?  @map("lead_id")
  agentId          String?  @map("agent_id")
  // Buyer's email captured directly from Stripe (session.customer_details.email)
  // for sales with no leadId -- the only way to know who paid when there's
  // no UserReport row to read an email from.
  buyerEmail       String?  @map("buyer_email")
  stripeSessionId  String   @unique @map("stripe_session_id")
  totalAmount      Decimal  @map("total_amount") @db.Decimal(10, 2)
  commissionRate   Decimal? @map("commission_rate") @db.Decimal(5, 4)
  commissionAmount Decimal? @map("commission_amount") @db.Decimal(10, 2)
  createdAt        DateTime @default(now()) @map("created_at")

  // SetNull (not Cascade): deleting a lead must never silently delete its
  // financial transaction history.
  lead  UserReport? @relation(fields: [leadId], references: [id], onDelete: SetNull)
  agent User?       @relation("AgentTransactions", fields: [agentId], references: [id], onDelete: SetNull)

  // All three back dashboard WHERE clauses: agentId (getAgentTransactions,
  // getAgentCommissionTotal aggregate), leadId (lead-detail transaction
  // lookups), buyerEmail (non-agent sales with no leadId to key off).
  @@index([agentId])
  @@index([leadId])
  @@index([buyerEmail])
  @@map("transactions")
}

// Centralized internal notes on a lead, shared between the owning AGENT and
// any ADMIN -- distinct from UserReport.agentNotes (the older, single-column
// JSON-blob note log written only by the owning agent, left in place and
// still displayed read-only for continuity, but no longer written to once
// this model is wired up). authorId carries whichever User wrote the note
// (agent or admin) so the UI can label "who wrote this", which the old
// JSON blob never could.
model LeadNote {
  id        String   @id @default(uuid())
  content   String
  authorId  String   @map("author_id")
  leadId    String   @map("lead_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  author User       @relation("LeadNoteAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  lead   UserReport @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId, createdAt])
  @@map("lead_notes")
}

model User {
  id                String             @id @default(uuid())
  name              String?
  email             String             @unique
  emailVerified     DateTime?          @map("email_verified")
  image             String?
  password          String?
  // CRM role-based access control. USER = consumer (default), AGENT = migration
  // agent with a lead portal, ADMIN = internal operator. Route protection keys
  // off this in proxy.ts + per-page requireRole() checks.
  role              String             @default("USER")
  // Which lead pool an AGENT account can see/claim from -- "TR" grants access
  // to Turkish Guide leads; other agents only see the Global Guide + Occupation
  // List pool. Unused for USER/ADMIN roles.
  market            String?            @map("market")
  // B2B affiliate/partner profile fields (AGENT accounts). Optional -- shown
  // in the admin agent detail page even when empty so the UI is ready once
  // agents are onboarded with this info.
  phone             String?
  companyName       String?            @map("company_name")
  address           String?
  // Per-agent commission percentage (e.g. 20 = 20%), set at account creation
  // by an admin. Unused for USER/ADMIN roles. NOTE: lib/stripe/commission.ts's
  // recordCommissionTransaction() still applies a single hardcoded
  // COMMISSION_RATE (0.2) to every agent and does NOT yet read this field --
  // wiring commission calculation to per-agent rates is a separate, deliberate
  // follow-up change, not done as part of adding this column.
  commissionRate    Float?             @map("commission_rate")
  // Self-registered AGENT accounts (/agent/register) start "PENDING" and
  // can't see their referral link or metrics until an admin approves them
  // (see /admin/crm/agent/[id]'s Approve action). Default is "APPROVED",
  // not "PENDING" -- this column's default also backfills every existing
  // row on creation, and pre-existing agents (created directly by an admin,
  // not through self-registration) must not suddenly lose access.
  approvalStatus    String             @default("APPROVED") @map("approval_status")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")
  accounts          Account[]
  savedCalculations SavedCalculation[]
  savedQuizResults  SavedQuizResult[]
  savedReports      SavedReport[]
  sessions          Session[]
  visaTrackings     VisaTracking[]
  visaJourneys      VisaJourney[]
  assignedLeads     UserReport[]       @relation("AgentAssignedLeads")
  transactions      Transaction[]      @relation("AgentTransactions")
  leadNotes         LeadNote[]         @relation("LeadNoteAuthor")

  // role: only 3 values, but getAgents()/getAgentUser() filter on it directly
  // (not alongside a more selective column) on every agent-portal/admin page
  // load, so it earns an exception to the low-cardinality rule.
  @@index([role])
  @@map("users")
}

model Account {
  id                String  @id @default(uuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model SavedCalculation {
  id            String   @id @default(uuid())
  userId        String   @map("user_id")
  visaSubclass  String?  @map("visa_subclass")
  totalPoints   Int      @map("total_points")
  breakdown     Json?
  createdAt     DateTime @default(now()) @map("created_at")
  country       String   @default("AU") @map("country")
  configVersion String?  @map("config_version")
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("saved_calculations")
}

model GuideDownload {
  id        String   @id @default(uuid())
  firstName String   @map("first_name")
  lastName  String   @map("last_name")
  email     String
  phone     String?
  locale    String   @default("tr")
  ipAddress String?  @map("ip_address")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("guide_downloads")
}

model GuideConfig {
  id           String @id @default("main")
  maxDownloads Int    @default(20) @map("max_downloads")

  @@map("guide_config")
}

model SavedQuizResult {
  id              String   @id @default(uuid())
  userId          String   @map("user_id")
  score           Int?
  readinessLevel  String?  @map("readiness_level")
  answers         Json?
  recommendations Json?
  createdAt       DateTime @default(now()) @map("created_at")
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("saved_quiz_results")
}

model SavedReport {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  reportType String   @default("full_check") @map("report_type")
  reportUrl  String?  @map("report_url")
  reportData Json?    @map("report_data")
  language   String   @default("en")
  createdAt  DateTime @default(now()) @map("created_at")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("saved_reports")
}

model VisaTracking {
  id           String    @id @default(uuid())
  userId       String    @map("user_id")
  visaSubclass String    @map("visa_subclass")
  status       String    @default("planning")
  notes        String?
  targetDate   DateTime? @map("target_date")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("visa_tracking")
}

// B2C Applicant Portal: stage-based process timeline, distinct from
// VisaTracking above (which is a lightweight "which subclass + free-text
// status am I watching" bookmark used by the existing consumer dashboard's
// visa-tracker page). VisaJourney is the structured backbone for the new
// Timeline UI (app/[locale]/(main)/dashboard's Journey card) -- one visa
// pathway's progress through fixed stages with a percentage, not a status
// string. A user could have both a VisaTracking bookmark and a VisaJourney
// for the same visaType; they're not meant to be merged into one model,
// since they serve different UI surfaces with different update cadences.
model VisaJourney {
  id                 String         @id @default(cuid())
  userId             String         @map("user_id")
  visaType           String         @map("visa_type")
  /**
   * See lib/constants/visa-stages.ts VISA_STAGES -- PREPARATION | ENGLISH_TEST | SKILLS_ASSESSMENT | EOI_NOMINATION | VISA_LODGE.
   */
  currentStage       String         @default("PREPARATION") @map("current_stage")
  progressPercentage Int            @default(0) @map("progress_percentage")
  createdAt          DateTime       @default(now()) @map("created_at")
  updatedAt          DateTime       @updatedAt @map("updated_at")
  user               User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  documents          VisaDocument[]

  @@index([userId])
  @@map("visa_journeys")
}

// Document Vault: per-stage evidence uploads for a VisaJourney. Stored in a
// private S3 bucket (lib/aws/s3.ts) -- fileKey is the S3 object key, NEVER a
// public URL. Every read goes through a short-lived pre-signed GetObject URL
// (getSecureDocumentUrlAction in app/[locale]/(main)/dashboard/actions.ts),
// re-checked against ownership on every call, since these are
// passport/ID-grade PII documents. `stage` is denormalized onto the
// document (not just derived from the journey's currentStage at query time)
// because a document uploaded during ENGLISH_TEST should stay tagged
// ENGLISH_TEST even after the journey advances past it.
model VisaDocument {
  id           String      @id @default(cuid())
  journeyId    String      @map("journey_id")
  /**
   * See lib/constants/visa-stages.ts VISA_STAGES.
   */
  stage        String
  /**
   * See lib/constants/visa-documents.ts VisaDocumentType -- PASSPORT | ENGLISH_TEST_RESULT | SKILLS_ASSESSMENT | ...
   */
  documentType String      @map("document_type")
  /**
   * S3 object key (e.g. "journeys/<journeyId>/<stage>/<uuid>-<filename>"),
   * not a URL -- the bucket is private. Resolve to a viewable link only via
   * getSecureDocumentUrlAction's pre-signed URL, never stored/cached here.
   */
  fileKey      String?     @map("file_key")
  /**
   * PENDING | AI_VERIFIED | REJECTED | MANUAL_REVIEW
   */
  status       String      @default("PENDING")
  /**
   * Free-text notes from an automated (OpenAI) review pass -- not wired up yet.
   */
  aiFeedback   String?     @map("ai_feedback") @db.Text
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")
  journey      VisaJourney @relation(fields: [journeyId], references: [id], onDelete: Cascade)

  @@index([journeyId])
  @@map("visa_documents")
}

// B2C EOI Queue page (app/[locale]/(main)/eoi-queue): per-occupation pool
// snapshot -- how many EOIs are sitting in the 189/491 pool for that
// occupation, the last observed 189 cutoff, and a rough wait-time/trend
// signal. Another purely additive, Prisma-only table -- no Drizzle overlap,
// so it needs no @@ignore treatment and doesn't touch the existing ignore
// list above.
model OccupationStat {
  id            String   @id @default(cuid())
  anzscoCode    String   @unique @map("anzsco_code")
  title         String
  /**
   * Broad category for the EOI Queue page's pill filters, e.g. "Healthcare", "Education", "Engineering".
   */
  tier          String
  pool189       Int      @default(0) @map("pool_189")
  pool190       Int      @default(0) @map("pool_190")
  cutoff189     Int?     @map("cutoff_189")
  avgWaitMonths Int?     @map("avg_wait_months")
  /**
   * UP | DOWN | FROZEN | STABLE
   */
  trend         String   @default("STABLE")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([tier])
  @@map("occupation_stats")
}

model PointsAlert {
  id            String    @id @default(uuid())
  email         String
  targetPoints  Int       @map("target_points")
  visaSubclass  String    @map("visa_subclass")
  isActive      Boolean   @default(true) @map("is_active")
  createdAt     DateTime  @default(now()) @map("created_at")
  lastTriggered DateTime? @map("last_triggered")

  @@map("points_alerts")
}

model EoiRound {
  id           String   @id @default(uuid())
  roundDate    DateTime @map("round_date")
  visaSubclass String   @map("visa_subclass")
  visaName     String   @map("visa_name")
  lowestPoints Int?     @map("lowest_points")
  invitations  Int
  poolSize     Int?     @map("pool_size")
  notes        String?
  isEstimated  Boolean  @default(false) @map("is_estimated")
  source       String   @default("scraper")
  createdAt    DateTime @default(now()) @map("created_at")

  @@unique([roundDate, visaSubclass])
  @@map("eoi_rounds")
}

// B2C "Invitation Rounds" feed (app/[locale]/(main)/rounds): individual
// per-occupation invitation records. NAMED InvitationFeedItem, NOT
// InvitationRound as originally requested, because a model named
// InvitationRound (mapped to the same "invitation_rounds" table) already
// exists below, under "DHA Invitation Rounds & Predictive Analytics" --
// it's a real, currently-used feature (prisma.roundCutoff is queried live
// by app/api/viability/route.ts and lib/services/report-service.ts via its
// InvitationRound -> RoundCutoff -> Occupation relations), not a stub.
// Reusing that name would have either collided (Prisma refuses two models
// with the same name) or silently repurposed a live table -- both wrong.
// This is a distinct, coarser-grained shape (one flat row per invited
// occupation/state/points, no normalized Occupation join) for this new
// feed UI specifically; it does not replace or relate to the existing
// InvitationRound/RoundCutoff/Occupation trio.
model InvitationFeedItem {
  id           String    @id @default(cuid())
  occupation   String
  /**
   * e.g. "189", "190", "491".
   */
  subclass     String
  /**
   * e.g. "Federal", "NSW", "VIC".
   */
  state        String
  /**
   * "Onshore" | "Offshore".
   */
  location     String
  points       Int
  /**
   * Null when the source row had no valid date cell -- never backfilled with today's date (see import-data.ts's parseDate).
   */
  dateOfEffect DateTime? @map("date_of_effect")
  /**
   * Null when the source row had no valid date cell -- never backfilled with today's date (see import-data.ts's parseDate).
   */
  roundDate    DateTime? @map("round_date")
  createdAt    DateTime  @default(now()) @map("created_at")

  @@index([roundDate])
  @@map("invitation_feed_items")
}

// Admin Data Sync panel (app/[locale]/(main)/admin/data-sync): one row per
// scraper source (see lib/constants/scraper-sources.ts's SCRAPER_SOURCES
// ids), tracking when it last ran and whether it succeeded -- backs each
// source card's "Last Sync" display. Written by app/api/admin/scrape/
// route.ts after every run (success or failure), not by the scrapers
// themselves (there are no real scrapers yet, per this task's explicit
// scope -- just the admin-triggered mock flow).
model ScraperSyncLog {
  id        String   @id @default(cuid())
  sourceId  String   @unique @map("source_id")
  lastRunAt DateTime @map("last_run_at")
  /**
   * "success" | "failed"
   */
  status    String
  message   String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("scraper_sync_logs")
}

// Monthly invitation-volume figures parsed from a state's "Invitations
// issued" program-year table (app/actions/admin/import-data.ts's "Mode 2:
// Volume Parsing" -- WA Excel exports have this as a second, separate
// section below the per-occupation points table, hence a separate model
// from InvitationFeedItem rather than overloading it with a differently-
// shaped row). No unique constraint on (state, stream, subclass, month):
// a re-upload deletes all of a state's prior volume rows before inserting
// the new batch (see import-data.ts), so duplicates within one import
// would indicate a parser bug, not a legitimate second data point.
model InvitationVolume {
  id        String   @id @default(cuid())
  state     String
  stream    String
  subclass  String
  /**
   * e.g. "2025-26" -- parsed from the section heading ("2025-26 program year — Invitations issued"). "Unknown" if that heading's year couldn't be parsed.
   */
  year      String @default("Unknown")
  month     String
  count     Int
  createdAt DateTime @default(now()) @map("created_at")

  @@index([state])
  @@index([year])
  @@map("invitation_volumes")
}

model ExpressEntryDraw {
  id                String    @id @default(uuid())
  drawDate          DateTime  @map("draw_date")
  programType       String    @map("program_type")
  crsScoreCutoff    Int?      @map("crs_score_cutoff")
  invitationsIssued Int       @map("invitations_issued")
  tieBreakRule      DateTime? @map("tie_break_rule")
  isEstimated       Boolean   @default(false) @map("is_estimated")
  source            String    @default("scraper")
  createdAt         DateTime  @default(now()) @map("created_at")

  @@unique([drawDate, programType])
  @@map("express_entry_draws")
}

model CaEoiRound {
  id          String   @id @default(uuid())
  drawNumber  Int      @unique @map("draw_number")
  roundDate   DateTime @map("round_date")
  drawName    String   @map("draw_name")
  crsScore    Int      @map("crs_score")
  invitations Int
  source      String   @default("scraper")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("ca_eoi_rounds")
}

// ── DHA Invitation Rounds & Predictive Analytics ──────────────────────────────

model InvitationRound {
  id           String        @id @default(cuid())
  date         DateTime
  visaSubclass String // e.g. "189", "491"
  totalInvited Int
  tieBreakDate DateTime? // Latest date of subclass scored at the minimum score
  notes        String?
  createdAt    DateTime      @default(now()) @map("created_at")
  cutoffs      RoundCutoff[]

  @@unique([date, visaSubclass])
  @@index([visaSubclass, date])
  @@map("invitation_rounds")
}

model Occupation {
  id         String        @id @default(cuid())
  anzscoCode String        @unique @map("anzsco_code")
  title      String
  createdAt  DateTime      @default(now()) @map("created_at")
  cutoffs    RoundCutoff[]

  @@index([title])
  @@map("occupations")
}

model RoundCutoff {
  id           String   @id @default(cuid())
  roundId      String   @map("round_id")
  occupationId String   @map("occupation_id")
  minimumScore Int      @map("minimum_score")
  createdAt    DateTime @default(now()) @map("created_at")

  round      InvitationRound @relation(fields: [roundId], references: [id], onDelete: Cascade)
  occupation Occupation      @relation(fields: [occupationId], references: [id], onDelete: Cascade)

  @@unique([roundId, occupationId])
  @@index([occupationId, roundId])
  @@map("round_cutoffs")
}

model StateAllocation {
  id              String   @id @default(cuid())
  programYear     String   @map("program_year") // e.g. "2025-26"
  state           String // e.g. "NSW", "VIC"
  visaSubclass    String   @map("visa_subclass") // "190" or "491"
  allocation      Int // Total allocation for the year
  nominationsUsed Int?     @map("nominations_used") // EOIs already nominated
  createdAt       DateTime @default(now()) @map("created_at")

  @@unique([programYear, state, visaSubclass])
  @@index([programYear, state])
  @@map("state_allocations")
}

// Autonomous state-migration status intelligence, kept fresh by a
// fortnightly scraper (app/api/cron/sync-states/route.ts) instead of manual
// edits to src/data/state-nomination-status.json. One row per state/
// territory/province code (AU + Canada PNP, sharing the same
// StateNominationCode space as lib/readiness/types.ts). lastVerifiedAt is
// when the bot last successfully re-checked the official source, not when
// this row was last written -- a failed scrape run should leave the
// previous verified data + timestamp in place rather than overwrite it with
// a false "just verified" claim.
model StateIntelligence {
  id             String    @id @default(uuid())
  stateCode      String    @unique @map("state_code")
  status         String
  officialNote   String?   @map("official_note") @db.Text
  sourceUrl      String?   @map("source_url")
  lastVerifiedAt DateTime? @map("last_verified_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@map("state_intelligence")
}

// Admin-managed "source of truth" for state nomination status -- distinct
// from StateIntelligence above (which is written by the automated
// scraper, app/api/cron/sync-states) and from
// lib/state-nomination/state-rules-config.ts (hand-verified but static,
// requires a code change + deploy to update). This table is what the
// admin panel at app/[locale]/(main)/admin/states writes to, and takes
// the HIGHEST priority of all three sources at read time (see
// lib/state-intelligence.ts's getStateNominationConfigMap and
// lib/readiness/state-nomination.ts) -- so toggling a state to "Closed"
// here is reflected immediately in both the PDF State Nomination Matrix
// and the AI Assistant, with no deploy required. Only status/supportedVisas
// /feeAud/customAiNote are admin-editable here; the longer knowledge-base
// prose (eligibility criteria, pathway descriptions) still comes from
// state-rules-config.ts / data/knowledge, which this table does not
// replace.
model StateNominationConfig {
  id             String   @id @default(cuid())
  stateCode      String   @unique @map("state_code")
  status         String
  /**
   * e.g. ["190", "491"] -- which visa subclasses this state currently sponsors.
   */
  supportedVisas String[] @map("supported_visas")
  feeAud         Float?   @map("fee_aud")
  customAiNote   String?  @map("custom_ai_note") @db.Text
  updatedBy      String?  @map("updated_by")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("state_nomination_configs")
}

// Structured, exact-value counterpart to the RAG pipeline: parsed directly
// from state occupation-list spreadsheets/CSVs (see
// scripts/sync-state-occupation-lists.ts, data/knowledge/State
// Immigrations/<state>/*.xlsx|*.csv) instead of embedded as vector chunks.
// Occupation lists are exact yes/no membership data -- letting the chatbot
// answer "is my occupation on the NSW 190 list" from a vector-similarity
// match over PDF text invites hallucination; a direct DB lookup here
// doesn't. sourceFile + syncedAt make re-running the sync idempotent (each
// run deletes-then-reinserts rows for the files it processed, see the
// script) and let a stale/failed sync be identified.
model StateOccupationListEntry {
  id              String   @id @default(cuid())
  stateCode       String   @map("state_code")
  anzscoCode      String?  @map("anzsco_code")
  occupationTitle String   @map("occupation_title")
  /**
   * e.g. ["190", "491"] -- which visa subclass list(s) this occupation appears on on this sheet/row.
   */
  visaSubclasses  String[] @map("visa_subclasses")
  /**
   * Raw extra columns from the source row (Status, Minimum Points, Stream, Priority Occupation, etc.) -- varies per state/file, so kept as JSON rather than one column per possible field.
   */
  metadata        Json?
  sourceFile      String   @map("source_file")
  syncedAt        DateTime @default(now()) @map("synced_at")

  @@index([stateCode])
  @@index([anzscoCode])
  @@map("state_occupation_list_entries")
}

// ── AI Chatbot: anonymous visitor tracking + chat history ──────────────────

model ChatVisitor {
  id             String        @id @default(uuid())
  ipAddress      String?       @map("ip_address")
  userAgent      String?       @map("user_agent")
  // Optional client-side hash (e.g. canvas/audio fingerprint) for de-duping
  // visitors whose IP changes (mobile networks, VPNs) — not required for
  // the basic IP+UA lookup in getVisitorContext().
  fingerprint    String?
  messageCount   Int           @default(0) @map("message_count")
  isPremium      Boolean       @default(false) @map("is_premium")
  // Pay-as-you-go credit balance from one-time Stripe purchases (see
  // app/[locale]/pricing). Decremented per premium message once the free
  // messageCount limit is hit; isPremium above stays reserved for a
  // separate unlimited/subscription grant.
  premiumCredits Int           @default(0) @map("premium_credits")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  sessions       ChatSession[]

  // Looked up by ipAddress+userAgent on every anonymous chat request in
  // getVisitorContext(); fingerprint indexed separately for the optional
  // client-hash lookup path.
  @@index([ipAddress, userAgent])
  @@index([fingerprint])
  @@map("chat_visitors")
}

model ChatSession {
  id        String        @id @default(uuid())
  visitorId String        @map("visitor_id")
  title     String?
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")
  visitor   ChatVisitor   @relation(fields: [visitorId], references: [id], onDelete: Cascade)
  messages  ChatMessage[]

  @@index([visitorId])
  @@map("chat_sessions")
}

model ChatMessage {
  id        String      @id @default(uuid())
  sessionId String      @map("session_id")
  // 'user' | 'assistant' | 'system' — plain String rather than an enum since
  // this mirrors the role field the LLM SDK message objects already use.
  role      String
  content   String      @db.Text
  createdAt DateTime    @default(now()) @map("created_at")
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
  @@map("chat_messages")
}

// RAG knowledge base: PDF chunks + embeddings for the chatbot to retrieve
// context from. embedding is Unsupported because Prisma Client has no
// native vector type -- reads/writes to that column go through $queryRaw /
// $executeRaw (see lib/pdf-processor.ts).
model DocumentChunk {
  id        String                       @id @default(cuid())
  content   String                       @db.Text
  metadata  Json // source PDF filename, page number, etc.
  embedding Unsupported("vector(1536)")? // text-embedding-3-small dimension
  createdAt DateTime                     @default(now()) @map("created_at")

  @@map("document_chunks")
}

// Drizzle-owned (see db/schema.ts's campaigns) — same as above. Introspected
// after this table nearly got dropped by an uninformed `prisma db push` --
// see the warning at the top of this file. Columns verified directly against
// the live table via information_schema (id/name are text, not
// serial/varchar, and the timestamp column is created_at, not updated_at --
// the original migration's design diverged from what actually got applied).
model campaigns {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Text
  name            String    @unique
  slots_remaining Int       @default(20)
  price           Int       @default(999)
  created_at      DateTime? @default(now()) @db.Timestamp(6)

  @@ignore
}

// Drizzle-owned (see db/schema.ts's contactMessages) — same as above.
model contact_messages {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  full_name  String
  email      String
  phone      String?
  message    String
  created_at DateTime? @default(now()) @db.Timestamp(6)

  @@index([email])
  @@ignore
}

// Drizzle-owned (see db/schema.ts's pdfDownloads) — same as above. This is
// the table involved in the earlier `prisma db push` near-miss.
model pdf_downloads {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  full_name         String
  email             String
  phone             String
  ip_address        String
  pdf_slug          String    @default("avustralya-pr-rehberi-2026")
  is_paid           Boolean?  @default(false)
  terms_accepted_at DateTime  @db.Timestamp(6)
  created_at        DateTime? @default(now()) @db.Timestamp(6)

  @@index([email])
  @@index([ip_address], map: "pdf_downloads_ip_idx")
  @@ignore
}

// Drizzle-owned (see db/schema.ts's visaTypes/visaStructuredData/
// sourceSnapshots) — same @@ignore treatment as the three models above,
// added after `prisma db push` proposed DROPping all three (they hold the
// live visa content seeded via db/seed.ts: 10 visa_types rows plus their
// structured data and PDF snapshot rows). Columns copied verbatim from
// db/schema.ts, which remains the source of truth for these tables --
// Drizzle keeps writing/migrating them; Prisma only needs to know they
// exist so `db push` stops proposing to drop them.
model visa_types {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  subclass        String    @unique
  visa_name       String
  category        String
  purpose         String?
  stay_period     String?
  cost            String?
  work_rights     String?
  source_url      String?
  last_checked    DateTime? @db.Date
  reviewed_status String?   @default("needs_review")
  created_at      DateTime? @default(now()) @db.Timestamp(6)
  updated_at      DateTime? @default(now()) @db.Timestamp(6)

  @@ignore
}

model visa_structured_data {
  id                     String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  visa_type_id           String    @db.Uuid
  key_requirements       Json?
  documents_required     Json?
  application_steps      Json?
  visa_conditions        Json?
  risks                  Json?
  english_requirements   Json?
  financial_requirements Json?
  raw_json               Json?
  created_at             DateTime? @default(now()) @db.Timestamp(6)
  updated_at             DateTime? @default(now()) @db.Timestamp(6)

  @@ignore
}

model source_snapshots {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  visa_type_id     String    @db.Uuid
  source_url       String
  pdf_snapshot_url String?
  raw_text         String?
  captured_at      DateTime? @default(now()) @db.Timestamp(6)
  content_hash     String?
  notes            String?

  @@ignore
}
